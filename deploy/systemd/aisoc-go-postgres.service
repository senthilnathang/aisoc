[Unit]
Description=AISOC release PostgreSQL

[Service]
Type=simple
Slice=aisoc-go.slice
WorkingDirectory=/opt/aisoc
ExecStart=/usr/bin/python3 /opt/aisoc/scripts/runtime/service.py postgres
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
