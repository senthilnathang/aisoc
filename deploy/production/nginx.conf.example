# Replace domain and certificate paths; validate with nginx -t before activation.
server {
    listen 443 ssl;
    server_name soc.example.invalid;
    ssl_certificate /etc/aisoc/tls/fullchain.pem;
    ssl_certificate_key /etc/aisoc/tls/private.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1m;
    root /opt/aisoc/frontend/dist;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    location /api/ {
        proxy_pass http://127.0.0.1:3002;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 30s;
    }
    location / { try_files $uri /index.html; }
}
