# Dependencies and build output
node_modules/
dist/
coverage/
.nyc_output/
.vite/
.cache/
*.tsbuildinfo

# Obsolete root-level publish output (builds now stay in frontend/dist/)
/frontend/assets/
/frontend/fonts/
/frontend/vendor/
/frontend/favicon.png

# Local environment configuration; keep shareable templates
.env
.env.*
!.env.example
!.env.*.example

# Runtime SQLite databases and sidecar files
/backend/data/*.db
/backend/data/*.db-*
/backend/data/*.sqlite
/backend/data/*.sqlite-*
/backend/data/*.sqlite3
/backend/data/*.sqlite3-*

# Logs and browser test artifacts
*.log
.run/
output/
.playwright-cli/
playwright-report/
test-results/

# Editor and operating-system files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Go build tools and test/profiling output
/backend-go/bin/
/backend-go/.tools/
/backend-go/*.test
/backend-go/coverage*.out
*.prof
*.pprof

# Python environments, bytecode and tool caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Specialist runtime build output; keep Cargo.lock and dependency lockfiles tracked
/services/*/.venv/
/services/*/target/
