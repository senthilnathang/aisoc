    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@vitejs/plugin-react": "4.4.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "playwright": "1.60.0",
    "vite": "6.4.5"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
