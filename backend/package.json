  },
  "dependencies": {
    "@fastify/cors": "10.0.2",
    "@sinclair/typebox": "0.34.33",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/node": "24.0.1",
    "tsx": "4.19.3",
    "typescript": "5.8.2"
  }
}
