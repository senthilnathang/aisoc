{
  "name": "sevenai-frontend-replica",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8080 --open /",
    "build": "vite build && node scripts/publish.mjs",
