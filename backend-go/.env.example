# Development only. Create a separate PostgreSQL database with this prefix.
AISOC_GO_DATABASE_URL=postgres://aisoc:replace-me@127.0.0.1:55435/aisoc_go_dev?sslmode=disable
AISOC_GO_ADDR=127.0.0.1:3003
AISOC_GO_POOL_SIZE=8
AISOC_GO_AUTH_MODE=local
AISOC_GO_DEFAULT_TENANT=demo
AISOC_GO_OPERATORS_FILE=
AISOC_GO_APP_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
AISOC_GO_SESSION_TTL_MS=28800000
AISOC_GO_SECURE_COOKIES=false
AISOC_GO_ENV=development
# Optional specialist configuration; leave worker addresses/token unset for core-only Go.
AISOC_PYTHON_ADDR=127.0.0.1:50051
# Python service only; Go execution uses the gRPC address above.
AISOC_PYTHON_HTTP_ADDR=127.0.0.1:8001
AISOC_RUST_ADDR=127.0.0.1:50052
# Generate with: python3 -c 'import secrets; print(secrets.token_hex(32))'
AISOC_WORKER_TOKEN=

# Optional until a nonempty connector credential is written. Retain across restarts.
# 32 random bytes encoded as 64 hexadecimal characters; never commit a real key.
AISOC_GO_CONNECTOR_KEY=
