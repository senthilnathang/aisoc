import { mkdirSync, readFileSync, readdirSync, writeFileSync } from "node:fs";
import { resolve, join } from "node:path";
import { DatabaseSync } from "node:sqlite";
import { buildApp } from "../backend/src/app.js";
import { mkdtempSync, rmSync } from "node:fs";
import { tmpdir } from "node:os";

process.env.NODE_ENV = "test";
const root = resolve(import.meta.dirname, "..");
const directory = mkdtempSync(join(tmpdir(), "aisoc-inventory-"));
const routes: any[] = [];
const app = await buildApp({ databasePath: join(directory, "inventory.sqlite"), workerEnabled: false, authMode: "local", operatorCredentials: [] }, instance => {
  instance.addHook("onRoute", route => {
    for (const method of Array.isArray(route.method) ? route.method : [route.method]) {
      if (["HEAD", "OPTIONS"].includes(method)) continue;
      routes.push({ method, path: route.url, access: route.config?.access || "operator-or-local", schema: route.schema || {}, bodyLimit: route.bodyLimit || 1048576 });
    }
  });
});
try {
  await app.ready();
  routes.sort((a,b) => a.path.localeCompare(b.path) || a.method.localeCompare(b.method));
  const db = new DatabaseSync(join(directory, "inventory.sqlite"), { readOnly: true });
  const tables = db.prepare("SELECT name, sql FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' ORDER BY name").all().map(row => {
    const name = String(row.name);
    const quote = '"' + name.replaceAll('"', '""') + '"';
    return { name, sql: row.sql, columns: db.prepare("PRAGMA table_info(" + quote + ")").all(), foreignKeys: db.prepare("PRAGMA foreign_key_list(" + quote + ")").all(), indexes: db.prepare("PRAGMA index_list(" + quote + ")").all() };
  });
  const versions = db.prepare("SELECT version FROM schema_migrations ORDER BY version").all().map(row=>row.version);
  db.close();
  mkdirSync(join(root,"contracts"), { recursive:true });
  mkdirSync(join(root,"docs/migration"), { recursive:true });
  writeFileSync(join(root,"contracts/current-backend.json"), JSON.stringify({ format_version:1, source:"Runtime route registration and migrated temporary database; no live data", migrations:versions, routes, tables },null,2)+"\n");
  const escape = (s: unknown) => String(s ?? "").replaceAll("|","\\|").replaceAll("\n"," ");
  const implemented = JSON.parse(readFileSync(join(root,"contracts/go-implementation.json"),"utf8")).routes as Record<string,string>;
  for(const key of Object.keys(implemented))if(!routes.some(r=>r.method+" "+r.path===key))throw Error("Unknown Go route mapping: "+key);
  writeFileSync(join(root,"docs/migration/ENDPOINT_MATRIX.md"), [
    "# Backend Endpoint Parity Matrix", "",
    "Generated by `scripts/backend-inventory.mts` from actual route registration, including dynamic CRUD.",
    "HEAD and CORS OPTIONS are framework behavior and excluded from this domain matrix.",
    "Full input schemas and limits are in [the machine-readable inventory](../../contracts/current-backend.json).",
    "A request reaching an endpoint is not proof of complete behavior parity. Go status comes from [implementation tracking](../../contracts/go-implementation.json).", "",
    "| Method | Path | Access | Input schemas | Go replacement |", "|---|---|---|---|---|",
    ...routes.map(r=>`| ${r.method} | \`${r.path}\` | ${r.access} | ${Object.keys(r.schema).join(", ") || "none"} | ${implemented[r.method+" "+r.path] || "Pending"} |`),
    "", `Total: ${routes.length} explicit method/path contracts.`, "",
    "Route behavior and errors: [API contract](../API_CONTRACT.md). Current coverage: [testing](../TESTING.md). Historical inventory: [Phase 0 record](PHASE_0_STATUS.md).",
  ].join("\n")+"\n");
  writeFileSync(join(root,"docs/migration/DATA_MIGRATION_MAP.md"), [
    "# Backend Data Migration Map", "",
    "Generated from a fresh migrated SQLite database, including response schema version 12.",
    "This is the legacy source inventory. Type hints below are historical candidates, not the active physical schema.",
    "All 26 legacy tables reconciled at cutover; see [release status](RELEASE_STATUS.md).",
    "Authoritative PostgreSQL DDL is in [Go migrations](../../backend-go/migrations/); see [the data model](../DATA_MODEL.md).",
    "SQL definitions, composite foreign keys, and index metadata are in [the inventory](../../contracts/current-backend.json).", "",
    `Applied migrations: ${versions.join(", ")}. Tables: ${tables.length}.`, "",
    ...tables.flatMap(table=>[
      "## "+table.name,"",
      "| Column | SQLite type | Required | Primary key order | Default | PostgreSQL candidate |", "|---|---|---|---|---|---|",
      ...table.columns.map((c:any)=>`| ${c.name} | ${c.type} | ${c.notnull ? "Yes" : "No"} | ${c.pk || ""} | ${escape(c.dflt_value)} | ${String(c.name).endsWith("_json") ? "jsonb after round-trip review" : c.type === "INTEGER" ? "bigint; review flags separately" : c.type === "REAL" ? "double precision" : "text; review timestamps separately"} |`),
      "", "Foreign keys: "+(table.foreignKeys.length ? table.foreignKeys.map((fk:any)=>`${fk.from} → ${fk.table}.${fk.to} (delete ${fk.on_delete})`).join("; ") : "none declared")+".",
      "", "Migration status: implemented and reconciled for the local release; physical representation may combine legacy tables.","",
    ]),
  ].join("\n").trimEnd()+"\n");
  const files = readdirSync(join(root,"frontend/src")).filter(file=>/\.(jsx|js)$/.test(file));
  const callers = files.flatMap(file=>readFileSync(join(root,"frontend/src",file),"utf8").split("\n").flatMap((line,index)=>/\bapi\./.test(line) ? [{file:"frontend/src/"+file,line:index+1,source:line.trim()}] : []));
  writeFileSync(join(root,"contracts/frontend-callers.json"),JSON.stringify({note:"Lexical caller index, not a resolved dependency map. Includes shared wrappers; manual journey mapping is required.",callers},null,2)+"\n");
  console.log(JSON.stringify({routes:routes.length,tables:tables.length,migrations:versions,frontendCallerLines:callers.length}));
} finally { await app.close(); rmSync(directory,{recursive:true,force:true}); }
